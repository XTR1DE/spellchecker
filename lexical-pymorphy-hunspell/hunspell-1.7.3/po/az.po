#: src/tools/hunspell.cxx:1310
msgid ""
"Whenever a word is found that is not in the dictionary\n"
"it is printed on the first line of the screen.  If the dictionary\n"
"contains any similar words, they are listed with a number\n"
"next to each one.  You have the option of replacing the word\n"
"completely, or choosing one of the suggested words.\n"
msgstr ""
"Lüğətdə olmayan bir söz tapıldıqda,\n"
"o, ekranın ilk sətirində çap olunur. Lüğətdə\n"
"oxşar sözlər varsa, onlar hər birinin yanında bir nömrə ilə göstərilir.\n"
"Sözü tamamilə əvəz etmək və ya\n"
" təklif olunan sözlərdən birini seçmək seçiminiz var.\n"

#: src/tools/hunspell.cxx:1316
msgid ""
"\n"
"Commands are:\n"
"\n"
msgstr ""
"\n"
"Əmrlər bunlardır:\n"
"\n"

#: src/tools/hunspell.cxx:1317
msgid "R\tReplace the misspelled word completely.\n"
msgstr "R\tSəhv yazılmış sözü tamamilə dəyişdirin.\n"

#: src/tools/hunspell.cxx:1318
msgid "Space\tAccept the word this time only.\n"
msgstr "Fasilə\tYalnız bu dəfə sözü qəbul edin.\n"

#: src/tools/hunspell.cxx:1320
msgid "A\tAccept the word for the rest of this session.\n"
msgstr "Q\tBu sessiyanın qalan hissəsi üçün sözü qəbul edin.\n"

#: src/tools/hunspell.cxx:1322
msgid "I\tAccept the word, and put it in your private dictionary.\n"
msgstr "D\tSözü qəbul edin və şəxsi lüğətinizə daxil edin.\n"

#: src/tools/hunspell.cxx:1324
msgid "U\tAccept and add lowercase version to private dictionary.\n"
msgstr "K\tQəbul edin və şəxsi lüğətə kiçik hərfli versiya əlavə edin.\n"

#: src/tools/hunspell.cxx:1326
msgid ""
"S\tAsk a stem and a model word and store them in the private dictionary.\n"
"\tThe stem will be accepted also with the affixes of the model word.\n"
msgstr ""
"S\tBir kök və model söz qəbul edin və onları şəxsi lüğətdə saxlayın.\n"
"\tKök, model sözün şəkilçiləri ilə də qəbul ediləcək.\n"

#: src/tools/hunspell.cxx:1330
msgid "0-n\tReplace with one of the suggested words.\n"
msgstr "0-n\tTəklif olunan sözlərdən biri ilə əvəz edin.\n"

#: src/tools/hunspell.cxx:1332
msgid ""
"X\tWrite the rest of this file, ignoring misspellings, and start next file.\n"
msgstr ""
"X\tSəhv yazılara məhəl qoymadan bu faylın qalan hissəsini yazın və növbəti "
"fayla başlayın.\n"

#: src/tools/hunspell.cxx:1335
msgid "Q\tQuit immediately. Asks for confirmation. Leaves file unchanged.\n"
msgstr "Q\tDərhal çıxın. Təsdiq istəyir. Faylı dəyişməz saxlayır.\n"

#: src/tools/hunspell.cxx:1337
msgid "^Z\tSuspend program. Restart with fg command.\n"
msgstr "^Z\tProqramı dayandırın. fg əmri ilə yenidən yüklədin.\n"

#: src/tools/hunspell.cxx:1338
msgid "?\tShow this help screen.\n"
msgstr "?\tBu kömək ekranını göstərin.\n"

#: src/tools/hunspell.cxx:1339
msgid ""
"\n"
"-- Type space to continue -- \n"
msgstr ""
"\n"
"-- Davam etmək üçün boşluq yazın -- \n"

